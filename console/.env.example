# Required
NODE_ENV=production
PORT=3100
CONSOLE_URL=https://console.cairn.dev

# Data storage (default: /data in production, .data/ in dev)
DATA_DIR=/data

# Stripe (optional — billing works in dev mode without these)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
